{
  "manifest_version": 3,
  "name": "Scroll Arrows",
  "version": "1.2.2",
  "description": "A gear-style scroll bar for every page. Scroll by hover, click, or drag, with custom size, color, and position.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
